{"hash":"04059be5e93e6350e7f4c8693b369d95d8d9a997b555455169243354188591f5","kind":"tool_output","origin":"OBSERVED","payload":{"bytes":665,"content":"\"\"\"Tiny key=value config parser.\"\"\"\n\nfrom __future__ import annotations\n\n\ndef parse_kv(text: str) -> dict[str, str]:\n    \"\"\"Parse ``key=value`` lines into a dict.\n\n    Blank lines and lines starting with ``#`` are ignored. Values may contain\n    ``=``; only the first one splits. Surrounding whitespace is stripped.\n    \"\"\"\n    result: dict[str, str] = {}\n    for raw in text.splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\"):\n            continue\n        key, sep, value = line.partition(\"=\")\n        if not sep:\n            raise ValueError(f\"missing '=' in line: {raw!r}\")\n        result[key] = value.strip()\n    return result\n","content_sha256":"b2263b4e475e8c236384e7757573183d87950c15348c83849f885068f0c00179","exit_code":null,"failed":false,"tool":"read_file","tool_use_id":"t0","tree":"62324dcf0dbb4eaabc5b0af15e4f0df1ad00a95b","truncated":false},"prev_hash":"d1916f6e4d2238ee59521856d7a6008cc6ca666bdceab36ff18c43814b65c6e1","seq":4,"sig":"UNSIGNED","ts":"2026-11-07T19:10:01.400Z"}
