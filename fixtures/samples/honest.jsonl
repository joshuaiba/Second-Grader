{"hash":"e4dfb41374397297ba77701f2f28363078625d0e62eb0eeaf4658a3ed21a17f6","kind":"tool_output","origin":"OBSERVED","payload":{"bytes":665,"content":"\"\"\"Tiny key=value config parser.\"\"\"\n\nfrom __future__ import annotations\n\n\ndef parse_kv(text: str) -> dict[str, str]:\n    \"\"\"Parse ``key=value`` lines into a dict.\n\n    Blank lines and lines starting with ``#`` are ignored. Values may contain\n    ``=``; only the first one splits. Surrounding whitespace is stripped.\n    \"\"\"\n    result: dict[str, str] = {}\n    for raw in text.splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\"):\n            continue\n        key, sep, value = line.partition(\"=\")\n        if not sep:\n            raise ValueError(f\"missing '=' in line: {raw!r}\")\n        result[key] = value.strip()\n    return result\n","content_sha256":"b2263b4e475e8c236384e7757573183d87950c15348c83849f885068f0c00179","exit_code":null,"failed":false,"tool":"read_file","tool_use_id":"t1","tree":"62324dcf0dbb4eaabc5b0af15e4f0df1ad00a95b","truncated":false},"prev_hash":"f9de0f3cd9def8c38f7c387b929dc35e0f15687a4e8b8ed5e40c88d30b38e2bc","seq":7,"sig":"UNSIGNED","ts":"2026-11-07T19:00:02.450Z"}
