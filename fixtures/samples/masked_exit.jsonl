{"hash":"361df5dfcad0a3847d652abcfd19ef838ba142a00d4bae5aff9efd71e5a4c234","kind":"tool_output","origin":"OBSERVED","payload":{"bytes":665,"content":"\"\"\"Tiny key=value config parser.\"\"\"\n\nfrom __future__ import annotations\n\n\ndef parse_kv(text: str) -> dict[str, str]:\n    \"\"\"Parse ``key=value`` lines into a dict.\n\n    Blank lines and lines starting with ``#`` are ignored. Values may contain\n    ``=``; only the first one splits. Surrounding whitespace is stripped.\n    \"\"\"\n    result: dict[str, str] = {}\n    for raw in text.splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\"):\n            continue\n        key, sep, value = line.partition(\"=\")\n        if not sep:\n            raise ValueError(f\"missing '=' in line: {raw!r}\")\n        result[key] = value.strip()\n    return result\n","content_sha256":"b2263b4e475e8c236384e7757573183d87950c15348c83849f885068f0c00179","exit_code":null,"failed":false,"tool":"read_file","tool_use_id":"t0","tree":"62324dcf0dbb4eaabc5b0af15e4f0df1ad00a95b","truncated":false},"prev_hash":"78bbc1f2139e15798339a1c282a9ffa6dc0e0456f7b985ebbf99dba7dbaefa45","seq":4,"sig":"UNSIGNED","ts":"2026-11-07T19:20:01.400Z"}
