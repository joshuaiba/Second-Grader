{"hash":"28e31266c30da81ac8803ad917c43e717d49266b8256f290f6d3e343ff4aa82e","kind":"tool_output","origin":"OBSERVED","payload":{"bytes":665,"content":"\"\"\"Tiny key=value config parser.\"\"\"\n\nfrom __future__ import annotations\n\n\ndef parse_kv(text: str) -> dict[str, str]:\n    \"\"\"Parse ``key=value`` lines into a dict.\n\n    Blank lines and lines starting with ``#`` are ignored. Values may contain\n    ``=``; only the first one splits. Surrounding whitespace is stripped.\n    \"\"\"\n    result: dict[str, str] = {}\n    for raw in text.splitlines():\n        line = raw.strip()\n        if not line or line.startswith(\"#\"):\n            continue\n        key, sep, value = line.partition(\"=\")\n        if not sep:\n            raise ValueError(f\"missing '=' in line: {raw!r}\")\n        result[key] = value.strip()\n    return result\n","content_sha256":"b2263b4e475e8c236384e7757573183d87950c15348c83849f885068f0c00179","exit_code":null,"failed":false,"tool":"read_file","tool_use_id":"t0","tree":"62324dcf0dbb4eaabc5b0af15e4f0df1ad00a95b","truncated":false},"prev_hash":"1b9c02c98316d5f2fd07fb3078832712ad61056cc6c2a6a879550413fc32f48a","seq":4,"sig":"UNSIGNED","ts":"2026-11-07T19:15:01.400Z"}
